
# DATABASE_URL -> Docker ortamına göre dinamik olacak!
DATABASE_URL=postgresql://postgres:mysecretpassword@${DB_HOST}:5432/fastapi_crud


# .env dosyası (GÜNCEL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=fastapi_crud
DB_HOST=postgres_db  # PostgreSQL için ortak isim

REDIS_HOST=redis_cache  # Redis için ortak isim
REDIS_PORT=6379


# Application Environment Variables
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True


DEPLOYMENT_TYPE=swarm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=fastapi_crud
